rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /learners/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['name', 'email', 'completed', 'assessments', 'seconds', 'lastActive'])
        && request.resource.data.keys().hasAll(['name', 'email', 'completed', 'assessments', 'seconds', 'lastActive'])
        && request.resource.data.name == request.auth.token.name
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.completed is list
        && request.resource.data.completed.size() <= 38
        && request.resource.data.assessments is map
        && request.resource.data.assessments.size() <= 38
        && request.resource.data.seconds is int
        && request.resource.data.seconds >= 0
        && request.resource.data.lastActive == request.time;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
